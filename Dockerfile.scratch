# syntax = docker/dockerfile:1.29.0@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183

# Stage 1: Dependencies (Alpine)
FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS alpine
RUN apk add --no-cache ca-certificates coreutils tini-static util-linux-misc
RUN mkdir /tmp-orig
RUN mkdir -p /priority-libs/lib /priority-libs/usr/lib && \
    cp -L /lib/ld-musl-*.so.1 /priority-libs/lib/ && \
    cp -L /usr/lib/libcrypto.so.3 /usr/lib/libacl.so.1 /usr/lib/libattr.so.1 \
      /usr/lib/libutmps.so.0.1 /usr/lib/libskarnet.so.2.15 /priority-libs/usr/lib/

ARG TARGETPLATFORM
# Binaries are staged per-platform by goreleaser dockers_v2
COPY $TARGETPLATFORM/backrest /backrest
RUN /backrest --install-deps-only

# Setup restic path
RUN mkdir -p /bin && mv /root/.local/share/backrest/restic /bin/restic

# Stage 2: Final Image (Scratch)
FROM scratch
LABEL org.opencontainers.image.source="https://github.com/baragoon/backrest"

COPY --from=alpine --chmod=1777 /tmp-orig /tmp
RUN --mount=from=alpine,source=/bin/busybox,target=/bin/busybox --mount=from=alpine,source=/lib,target=/lib ["/bin/busybox", "chmod", "1777", "/tmp"]
COPY --from=alpine /priority-libs/ /
# Alpine's coreutils binary dispatches to nice based on its filename.
COPY --from=alpine /bin/coreutils /bin/nice
COPY --from=alpine /bin/ionice /bin/ionice
COPY --from=alpine /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=alpine /bin/restic /bin/restic
COPY --from=alpine /sbin/tini-static /tini

ARG TARGETPLATFORM
COPY $TARGETPLATFORM/backrest /backrest
COPY $TARGETPLATFORM/docker-entrypoint /docker-entrypoint

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    BACKREST_HEALTHCHECK=1

HEALTHCHECK --interval=30s --timeout=5s --start-period=5m --retries=3 CMD ["/backrest", "health"]

ENTRYPOINT ["/tini", "--", "/docker-entrypoint"]
CMD ["/backrest"]
