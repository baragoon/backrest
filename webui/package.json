{
  "name": "backrest",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start": "UI_BACKEND_URL=http://localhost:9898 vite",
    "clean": "rimraf dist",
    "clean-windows": "rimraf dist-windows",
    "build": "cross-env UI_OS=unix vite build",
    "build-windows": "cross-env UI_OS=windows vite build --outDir dist-windows",
    "check": "tsc --noEmit",
    "compile-i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "test": "pnpm run compile-i18n && vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "translate": "tsx scripts/translate-gemini.ts && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "translate-reprocess": "tsx scripts/translate-gemini.ts --reprocess && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "format": "prettier --write ."
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bufbuild/protobuf": "^2.5.2",
    "@chakra-ui/react": "^3.30.0",
    "@connectrpc/connect": "^2.0.2",
    "@connectrpc/connect-web": "^2.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "buffer": "^6.0.3",
    "cronstrue": "^3.9.0",
    "cross-env": "^10.1.0",
    "events": "^3.3.0",
    "motion": "^14.0.0",
    "next-themes": "^0.4.6",
    "process": "^0.11.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.5.0",
    "react-js-cron": "^6.0.0",
    "react-router": "^8.1.0",
    "react-virtualized": "^10.0.0",
    "recharts": "^3.9.0"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "devDependencies": {
    "@google/generative-ai": "0.24.1",
    "@inlang/cli": "3.6.0",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/sdk": "4.2.0",
    "@lix-js/client": "2.2.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/crypto-js": "4.2.2",
    "@types/node": "26.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-virtualized": "9.22.4",
    "@vitejs/plugin-react": "6.3.0",
    "dotenv": "18.0.10",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "rc-collapse": "4.0.0",
    "rimraf": "6.1.4",
    "rollup-plugin-visualizer": "7.1.3",
    "sass": "1.108.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-compression": "0.5.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  }
}
